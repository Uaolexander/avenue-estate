#!/bin/zsh
# Подвійний клік по цьому файлу запускає сайт локально й відкриває його в браузері.
# Щоб зупинити сайт — закрий вікно Терміналу, яке відкриється.

# Працює і з самої папки проєкту, і якщо файл скопіювати на робочий стіл.
PROJECT="/Users/dianahodna/Projects/avenue-estate"
[ -f "$(dirname "$0")/package.json" ] && PROJECT="$(dirname "$0")"
cd "$PROJECT" || exit 1

# nvm ставить node не в системну папку, тому підвантажуємо його вручну:
# при подвійному кліку .zshrc не читається.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

if ! command -v node > /dev/null 2>&1; then
  echo "Не вдалося знайти Node.js. Напиши про це Клоду або Олександру."
  echo "Вікно можна закрити."
  read -r
  exit 1
fi

# Перший запуск після розпакування архіву: залежностей ще немає.
if [ ! -d node_modules ]; then
  echo "Перший запуск, встановлюю потрібні файли. Це займе хвилину..."
  npm install || exit 1
fi

echo ""
echo "Запускаю сайт. Зараз відкриється браузер."
echo "ЩОБ ЗУПИНИТИ САЙТ — просто закрий це вікно."
echo ""

# Даємо серверу піднятись, тоді відкриваємо вкладку.
( sleep 3; open http://localhost:5173/ ) &

npm run dev
